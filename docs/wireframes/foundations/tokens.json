{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Music Copilot Low-fidelity Foundations",
  "version": "1.0.0",
  "mode": "wireframe",
  "unit": "dp/sp",
  "color": {
    "gray": {
      "000": { "$type": "color", "$value": "#FFFFFF" },
      "050": { "$type": "color", "$value": "#F7F7F7" },
      "100": { "$type": "color", "$value": "#EEEEEE" },
      "300": { "$type": "color", "$value": "#C7C7C7" },
      "500": { "$type": "color", "$value": "#8A8A8A" },
      "700": { "$type": "color", "$value": "#4A4A4A" },
      "900": { "$type": "color", "$value": "#171717" }
    },
    "semantic": {
      "canvas": { "$type": "color", "$value": "{color.gray.050}" },
      "surface": { "$type": "color", "$value": "{color.gray.000}" },
      "subtle": { "$type": "color", "$value": "{color.gray.100}" },
      "inverse": { "$type": "color", "$value": "{color.gray.900}" },
      "textPrimary": { "$type": "color", "$value": "{color.gray.900}" },
      "textSecondary": { "$type": "color", "$value": "{color.gray.700}" },
      "textMuted": { "$type": "color", "$value": "{color.gray.500}" },
      "textInverse": { "$type": "color", "$value": "{color.gray.000}" },
      "border": { "$type": "color", "$value": "{color.gray.300}" },
      "borderStrong": { "$type": "color", "$value": "{color.gray.700}" }
    }
  },
  "spacing": {
    "4": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "32": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "small": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "medium": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
  },
  "size": {
    "touchTargetMin": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "deviceWidth": { "$type": "dimension", "$value": { "value": 360, "unit": "px" } },
    "deviceHeight": { "$type": "dimension", "$value": { "value": 800, "unit": "px" } },
    "appBarHeight": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
    "bottomNavigationHeight": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
  },
  "typography": {
    "title": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 24, "fontWeight": 600, "lineHeight": 32, "letterSpacing": 0 } },
    "heading": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 20, "fontWeight": 600, "lineHeight": 28, "letterSpacing": 0 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 16, "fontWeight": 400, "lineHeight": 24, "letterSpacing": 0 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 14, "fontWeight": 600, "lineHeight": 20, "letterSpacing": 0 } }
  }
}

