  "contracts": {
    "explicit_ptt_only": true,
    "no_auto_stt_after_onResume": true,
    "android_os_microphone_truth": "ContextCompat.checkSelfPermission(RECORD_AUDIO) at the live canBeginSession boundary",
    "foreground_truth": "Activity onStart/onStop driven volatile uiVoiceStarted; not DataStore",
    "worker_admission": "isCurrentAndAuthorizedLocked under one coordinator gate: session ID, Job identity, attempt, Job active and foreground/OS mic grant",
    "cancellation_without_permission": "invalidateLocked -> Idle, cancel STT/TTS/prompts/timeout/Job; token-scoped duck release",
    "synchronous_token_admission": "confirm/neither/cancel/expiry must verify current generation and live authority",
    "late_stt": "invalidated on resume after suspended recognition, no dispatch",
    "late_ack": "cannot report Executed/Playing once voice generation invalidated, even if service previously accepted a command",
    "confidence": "No provider confidence synthesized; existing P05 untouched",
    "duck": "Single service voice duck token UUID with release in finally/cancel and 22s service-owned TTL fallback",
    "tts": "P09 one-sentence prompt canceled on selection/timeout/lifecycle; no late speech result if voice canceled",
    "route": "Service AudioDeviceCallback/noisy and quarantine preexisting; cannot assume BT is active audio route, no auto Play",
    "focus": "Preexisting Media3 owner invokes PlaybackVoiceInterruptionHost; not call identity, no telephony listener",
    "screen_off": "Only Voice session ends at UI stop; service-owned real active media is not paused by UI",
    "recreation": "No pending confirmation token/artist in SavedState; new voice coordinator default Idle",
    "process_death": "No voice pending authority or auto-dispatch restore",
    "no_second_player": true,
    "no_second_focus_owner": true,
    "no_background_mic": true,
    "previous_five_commands": "Existing Issue #10 Mapper/Dispatcher unchanged; fresh-permission gate applies to all voice commands"
  },
  "scenarios": {
    "foreground_revocation": "onResume observes OS permission; no automatic regrant start",
    "active_stt_cancel": "generation invalidation beats stale STT callback",
    "active_confirmation_cancel": "token denied and prompt stopped",
    "selected_artist_late_ack": "no new success callback or replay; already-accepted service change cannot be retroactively undone",
    "bluetooth_disconnect": "preexisting service route gate SafePaused + voice cancellation",
    "bluetooth_reconnect": "observation only, no Play",
    "call_focus": "cancel voice from service focus guard before late callback",
    "p13_hardware_tests": "Pending owner phone QA; no real route/call/BT/TTS validated"
  },
